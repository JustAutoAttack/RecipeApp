# ==========================================
# Rust & Cargo
# ==========================================
/target/
**/target/
**/*.rs.bk
# Cargo.lock is recommended for binary applications to ensure reproducible builds,
# but can be ignored if preferred.

# ==========================================
# Node.js & Vite (Frontend / Root Workspace)
# ==========================================
/node_modules/
/dist/
/dist-ssr/
*.local
.vite/
/mise/node_modules/

