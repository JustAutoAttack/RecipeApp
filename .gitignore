# Tauri v2 Desktop Workspace
# ==========================================
/mise/src-tauri/target/
/mise/src-tauri/gen/
/mise/src-tauri/wix/*.msi
/mise/src-tauri/nsis/*.exe

# ==========================================
# Python & FastAPI Dev Server
# ==========================================
/dev_server/.venv/
.venv/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
*.egg-info/

# ==========================================
